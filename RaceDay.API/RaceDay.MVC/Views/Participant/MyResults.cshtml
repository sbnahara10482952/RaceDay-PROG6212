@model List<RaceDay.MVC.ViewModels.ResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">My Race Results</h2>
        <p class="text-muted">
            View your recorded race results and performance.
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You do not have any recorded race results yet.
            Your results will appear here once an organiser records them.
        </div>
    }
    else
    {
        <div class="row mb-4">

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted">Total Results</h6>
                        <h3 class="fw-bold">@Model.Count</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted">Finished Races</h6>
                        <h3 class="fw-bold text-success">
                            @Model.Count(r => r.ResultStatus == "Finished")
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted">Best Position</h6>
                        <h3 class="fw-bold">
                            @(Model.Where(r => r.Position.HasValue)
                                .Select(r => r.Position)
                                .DefaultIfEmpty(null)
                                .Min()?.ToString() ?? "-")
                        </h3>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm">

            <div class="card-header">
                <h5 class="mb-0">Race History</h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Event</th>
                                <th>Event Date</th>
                                <th>Location</th>
                                <th>Race Number</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var result in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>@result.EventName</strong>
                                    </td>

                                    <td>
                                        @result.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>@result.Location</td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @result.RaceNumber
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(result.FinishTime)
                                            ? "-"
                                            : result.FinishTime)
                                    </td>

                                    <td>
                                        @(result.Position?.ToString() ?? "-")
                                    </td>

                                    <td>
                                        @if (result.ResultStatus == "Finished")
                                        {
                                            <span class="badge bg-success">
                                                Finished
                                            </span>
                                        }
                                        else if (result.ResultStatus == "DNS")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                DNS
                                            </span>
                                        }
                                        else if (result.ResultStatus == "DNF")
                                        {
                                            <span class="badge bg-danger">
                                                DNF
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @result.ResultStatus
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>