@model List<RaceDay.MVC.ViewModels.EventViewModel>

@{
ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">

<div class="mb-4">
    <h1 class="fw-bold">Participant Dashboard</h1>
    <p class="text-muted">
        Welcome to RaceDay. Discover upcoming races and manage your running journey.
    </p>
</div>

<div class="mb-4">
    <h3 class="fw-bold">Upcoming Events</h3>
    <p class="text-muted">
        Explore the races currently available on RaceDay.
    </p>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}
else if (Model == null || !Model.Any())
{
    <div class="alert alert-info" role="status">
        There are currently no upcoming events available.
        Please check again later.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var raceEvent in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <span class="badge bg-success mb-2">
                            @raceEvent.Status
                        </span>

                        <h5 class="card-title fw-bold">
                            @raceEvent.EventName
                        </h5>

                        <p class="card-text text-muted">
                            @raceEvent.Description
                        </p>

                        <hr />

                        <p class="mb-2">
                            <strong>Date:</strong>
                            @raceEvent.EventDate.ToString("dd MMMM yyyy")
                        </p>

                        <p class="mb-2">
                            <strong>Start Time:</strong>
                            @raceEvent.StartTime.ToString(@"hh\:mm")
                        </p>

                        <p class="mb-2">
                            <strong>Location:</strong>
                            @raceEvent.Location
                        </p>

                        <p class="mb-2">
                            <strong>Distance:</strong>
                            @raceEvent.DistanceKm km
                        </p>

                        <p class="mb-0">
                            <strong>Event Type:</strong>
                            @raceEvent.EventType
                        </p>
                        <hr />

                        <a asp-controller="Participant"
                            asp-action="Details"
                            asp-route-id="@raceEvent.EventID"
                            class="btn btn-primary">
                                View Details
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}

</div>
