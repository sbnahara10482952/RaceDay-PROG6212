@model List<RaceDay.MVC.ViewModels.ResultViewModel>

@{
    ViewData["Title"] = "Event Results";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Event Results</h2>
            <p class="text-muted">
                @ViewBag.EventName
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Enrolments"
           asp-route-eventId="@ViewBag.EventID"
           class="btn btn-outline-secondary">
            Back to Enrolments
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Recorded Race Results</h5>
        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No race results have been recorded for this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Position</th>
                                <th>Participant</th>
                                <th>Race Number</th>
                                <th>Finish Time</th>
                                <th>Result Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td>
                                        @if (result.Position.HasValue)
                                        {
                                            @result.Position
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>@result.ParticipantName</td>

                                    <td>@result.RaceNumber</td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(result.FinishTime))
                                        {
                                            @result.FinishTime
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>
                                        @if (result.ResultStatus == "Finished")
                                        {
                                            <span class="badge bg-success">
                                                Finished
                                            </span>
                                        }
                                        else if (result.ResultStatus == "DNS")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                DNS
                                            </span>
                                        }
                                        else if (result.ResultStatus == "DNF")
                                        {
                                            <span class="badge bg-danger">
                                                DNF
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @result.ResultStatus
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>