@model List<RaceDay.MVC.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Manage Race Categories";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Manage Race Categories</h1>
        <p class="text-muted">
            Select an event to manage its race categories, entry fees and participant limits.
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not created any events yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <span class="badge bg-success mb-2">
                                @raceEvent.Status
                            </span>

                            <h5 class="card-title fw-bold">
                                @raceEvent.EventName
                            </h5>

                            <p class="text-muted">
                                @raceEvent.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <a asp-controller="Organiser"
                               asp-action="ManageCategories"
                               asp-route-eventId="@raceEvent.EventID"
                               class="btn btn-primary">
                                Manage Categories
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>