@model List<RaceDay.MVC.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Events</h1>
            <p class="text-muted">
                Create, view, update and cancel your RaceDay events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            Create New Event
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not created any events yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <span class="badge bg-success mb-2">
                                @raceEvent.Status
                            </span>

                            <h5 class="card-title fw-bold">
                                @raceEvent.EventName
                            </h5>

                            <p class="text-muted">
                                @raceEvent.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Time:</strong>
                                @raceEvent.StartTime.ToString(@"hh\:mm")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @raceEvent.DistanceKm km
                            </p>

                            <p>
                                <strong>Event Type:</strong>
                                @raceEvent.EventType
                            </p>

                            <div class="mt-3 d-flex gap-2">

                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@raceEvent.EventID"
                                   class="btn btn-warning">
                                    Edit Event
                                </a>

                                <a asp-controller="Organiser"
                                   asp-action="Enrolments"
                                   asp-route-eventId="@raceEvent.EventID"
                                   class="btn btn-info btn-sm">
                                     View Enrolments
                                </a>

                                @if (raceEvent.Status != "Cancelled")
                                {
                                    <form asp-controller="Organiser"
                                          asp-action="CancelEvent"
                                          asp-route-id="@raceEvent.EventID"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this event?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-danger">
                                            Cancel Event
                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>